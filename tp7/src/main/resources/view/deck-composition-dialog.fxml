<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="fr.bts.iris.slam.controller.DeckCompositionController"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <VBox spacing="10" style="-fx-padding: 10;">
            <Button fx:id="saveButton" text="Enregistrer" onAction="#handleConfirm"/>
        </VBox>
    </top>


    <center>
        <TableView fx:id="flashcardsTable" editable="true">
            <columns>
                <TableColumn fx:id="questionColumn" text="Question" prefWidth="320" editable="false"/>
                <TableColumn fx:id="answerColumn" text="Réponse" prefWidth="280" editable="false"/>
                <TableColumn fx:id="inDeckColumn" text="Dans le deck" prefWidth="50"/>
            </columns>
        </TableView>
    </center>

</BorderPane>
